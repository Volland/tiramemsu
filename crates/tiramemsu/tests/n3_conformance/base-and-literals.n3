# Selecting an adult with an English name
#
# People have language-tagged names and numeric ages. N3 rules unpack each
# name's language tag and check the age threshold to identify an adult with
# an English name.

@prefix log: <http://www.w3.org/2000/10/swap/log#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix math: <http://www.w3.org/2000/10/swap/math#> .
@prefix : <http://example/> .

:alice :name "Alice Smith"@en ;
    :age 22 .
:bob :name "Bob"@nl ;
    :age 17 .

{
    ?person :name ?name .
    ?person :age ?age .
    ?pair log:langlit ?name .
    ?pair list:firstRest (?value ?rest) .
    ?rest list:firstRest (?lang ?rest2) .
    ?lang log:equalTo "en" .
    ?age math:notLessThan 18
} => {
    ?person :adult true
} .

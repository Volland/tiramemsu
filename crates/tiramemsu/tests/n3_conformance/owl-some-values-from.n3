# Recognizing a class from one matching value
#
# Alice has a pet classified as a cat, and cat is a subclass of animal.
# Explicit N3 rules interpret existential restriction facts to derive the
# supported owner classifications.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Sample data
:CatOwner owl:onProperty :pet ;
    owl:someValuesFrom :Cat .
:alice :pet :milo .
:milo a :Cat .
:Cat rdfs:subClassOf :Animal .
:AnimalOwner owl:onProperty :pet ;
    owl:someValuesFrom :Animal .

# Inference rules
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

{
    ?C owl:someValuesFrom ?Y .
    ?C owl:onProperty ?P .
    ?U ?P ?V .
    ?V a ?Y
} => {
    ?U a ?C
} .

{
    ?C owl:someValuesFrom owl:Thing .
    ?C owl:onProperty ?P .
    ?U ?P ?V
} => {
    ?U a ?C
} .

{
    ?C owl:someValuesFrom ?Y .
    ?C owl:onProperty ?P .
    ?D owl:someValuesFrom ?Z .
    ?D owl:onProperty ?P .
    ?Y rdfs:subClassOf ?Z
} => {
    ?C rdfs:subClassOf ?D
} .

{
    ?C owl:someValuesFrom ?Y .
    ?C owl:onProperty ?P .
    ?D owl:someValuesFrom ?Y .
    ?D owl:onProperty ?Q .
    ?P rdfs:subPropertyOf ?Q
} => {
    ?C rdfs:subClassOf ?D
} .

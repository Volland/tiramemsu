# Propagating equivalent class memberships
#
# Human, person, and individual classes are linked by equivalence
# declarations. Explicit N3 rules extend those links and derive the
# corresponding classifications for the sample people.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Sample data
:Human owl:equivalentClass :Person .
:Person owl:equivalentClass :Individual .
:alice a :Human .
:bob a :Individual .

# Inference rules
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

{
    ?A owl:equivalentClass ?B .
    ?X a ?A
} => {
    ?X a ?B
} .

{
    ?A owl:equivalentClass ?B .
    ?X a ?B
} => {
    ?X a ?A
} .

{
    ?A owl:equivalentClass ?B
} => {
    ?B owl:equivalentClass ?A
} .

{
    ?A owl:equivalentClass ?B .
    ?B owl:equivalentClass ?C
} => {
    ?A owl:equivalentClass ?C
} .

{
    ?A owl:equivalentClass ?B
} => {
    ?A rdfs:subClassOf ?B .
    ?B rdfs:subClassOf ?A
} .

{
    ?A rdfs:subClassOf ?B .
    ?B rdfs:subClassOf ?A
} => {
    ?A owl:equivalentClass ?B
} .

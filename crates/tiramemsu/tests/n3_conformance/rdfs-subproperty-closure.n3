# Following a chain of properties
#
# Mother-of is a subproperty of parent-of, which is a subproperty of
# ancestor-of. Explicit N3 rules extend these declarations and derive
# inherited relationships and domain or range consequences.

@prefix : <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix list: <http://www.w3.org/2000/10/swap/list#> .
@prefix log: <http://www.w3.org/2000/10/swap/log#> .

# Sample data
:motherOf rdfs:subPropertyOf :parentOf .
:parentOf rdfs:subPropertyOf :ancestorOf ;
    rdfs:domain :Person ;
    rdfs:range :Person .
:alice :motherOf :bob .

# Inference rules
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

{
    ?P rdfs:subPropertyOf ?Q .
    ?S ?P ?O
} => {
    ?S ?Q ?O
} .

{
    ?P rdfs:subPropertyOf ?Q .
    ?Q rdfs:subPropertyOf ?R
} => {
    ?P rdfs:subPropertyOf ?R
} .

{
    ?P rdfs:subPropertyOf ?Q .
    ?Q rdfs:domain ?C
} => {
    ?P rdfs:domain ?C
} .

{
    ?P rdfs:subPropertyOf ?Q .
    ?Q rdfs:range ?C
} => {
    ?P rdfs:range ?C
} .

# Deriving descent from parent facts
#
# Father and mother facts describe a small family. Forward N3 rules derive
# child relationships and recursively extend them into direct and indirect
# descent.

@prefix : <http://example/> .

:A :fatherOf :X .
:B :motherOf :X .
:C :motherOf :A .

{
    ?y :fatherOf ?x
} => {
    ?x :childOf ?y
} .

{
    ?y :motherOf ?x
} => {
    ?x :childOf ?y
} .

{
    ?x :childOf ?y
} => {
    ?x :descendedFrom ?y
} .

{
    ?x :childOf ?z .
    ?z :descendedFrom ?y
} => {
    ?x :descendedFrom ?y
} .

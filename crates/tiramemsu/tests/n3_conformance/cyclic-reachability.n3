# Finding paths around a cycle
#
# Three edges form a directed cycle. Recursive forward N3 rules derive
# reachable pairs, stopping when every consequence is already present.

@prefix : <https://eyereasoner.github.io/eyepl/examples/cyclic-reachability#> .

:a :edge :b .
:b :edge :c .
:c :edge :a .

{
    ?x :edge ?y
} => {
    ?x :path ?y
} .

{
    ?x :path ?y .
    ?y :edge ?z
} => {
    ?x :path ?z
} .

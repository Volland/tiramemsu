# Family BB: two distinct Edge anchors of one store with equal in-set and equal out-set.
# Returns the offending stores; an empty result means extensional.
PREFIX mg: <urn:mg:>
SELECT DISTINCT ?store WHERE {
  ?e1 mg:class mg:Edge ; mg:inStore ?store .
  ?e2 mg:class mg:Edge ; mg:inStore ?store .
  FILTER (STR(?e1) < STR(?e2))
  FILTER NOT EXISTS { ?e1 mg:in  ?x . FILTER NOT EXISTS { ?e2 mg:in  ?x } }
  FILTER NOT EXISTS { ?e2 mg:in  ?x . FILTER NOT EXISTS { ?e1 mg:in  ?x } }
  FILTER NOT EXISTS { ?e1 mg:out ?x . FILTER NOT EXISTS { ?e2 mg:out ?x } }
  FILTER NOT EXISTS { ?e2 mg:out ?x . FILTER NOT EXISTS { ?e1 mg:out ?x } }
}
